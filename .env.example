# .env.example — a TEMPLATE for real environment variables.
# Copy this file to ".env" (which git ignores) and fill in real values.
# NEVER put real secrets in this file or any committed file.

# --- Server settings ---
# 127.0.0.1 means "this computer only". Do NOT change to 0.0.0.0
# unless you understand the security risk (0.0.0.0 = reachable from
# your whole network / the internet).
HOST=127.0.0.1
PORT=8000

# --- Database ---
# Path to the SQLite file. Relative to the project folder.
DATABASE_PATH=db/agents.sqlite

# --- Reserved for version 2+ (real AI models) ---
# These are PLACEHOLDERS. Version 1 does not use them.
# They exist so you can see the pattern: secrets live in .env, never in code.
# MODEL_API_KEY=your-key-here
# MODEL_NAME=your-model-name
